---
import fs from 'fs';
import path from 'path';

const { lang = 'en' } = Astro.props;
const isZh = lang === 'zh';

const navItems = isZh
  ? [
      { href: '/zh/', label: '首页' },
      { href: '/zh/about', label: '关于我们' },
      { href: '/zh/products', label: '产品目录' },
      { href: '/zh/certifications', label: '资质合规' },
      { href: '/zh/contact', label: '联系我们' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/about', label: 'About Us' },
      { href: '/products', label: 'Products' },
      { href: '/certifications', label: 'Certifications' },
      { href: '/contact', label: 'Contact' },
    ];

const homeHref = isZh ? '/zh/' : '/';
const otherLangHref = isZh ? '/' : '/zh/';
const otherLangLabel = isZh ? 'EN' : '中文';
const ctaLabel = isZh ? '立即询盘' : 'Request a Quote';
const ctaHref = isZh ? '/zh/contact' : '/contact';
const logoText = isZh ? '汇农天下' : 'Huinong';

// 检测 logo 文件是否存在
const logoPath = '/assets/images/logo/main.png';
const logoExists = fs.existsSync(path.join(process.cwd(), 'public/assets/images/logo/main.png'));
---
<nav class="nav">
  <div class="container nav-inner">
    <a href={homeHref} class="logo">
      {logoExists && <img class="logo-img" src={logoPath} alt="汇农天下" />}
      <span class="logo-text">{logoText}</span>
    </a>
    <div class="nav-links">
      {navItems.map(item => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={otherLangHref} class="lang-switch">{otherLangLabel}</a>
      <a href={ctaHref} class="nav-cta">{ctaLabel}</a>
    </div>
  </div>
</nav>

<style>
.nav {
  position: sticky; top: 0; z-index: 100;
  background: var(--white);
  border-bottom: 1px solid var(--cream-dark);
}
.nav-inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 72px;
}
.logo {
  display: flex; align-items: center; gap: 10px;
  color: var(--green);
  font-family: 'Playfair Display', 'Georgia', serif;
  font-size: 22px; font-weight: 700;
  letter-spacing: -0.5px;
  line-height: 1;
}
.logo-img {
  height: 40px; width: auto; max-width: 180px; object-fit: contain;
  display: block;
}
.logo-text { color: var(--green); }
.nav-links { display: flex; gap: 28px; align-items: center; }
.nav-links a {
  font-size: 14px; font-weight: 500; color: var(--text);
  transition: color .2s;
}
.nav-links a:hover { color: var(--green); }
.lang-switch {
  font-size: 13px;
  padding: 4px 10px;
  border: 1px solid var(--cream-dark);
  border-radius: 4px;
  color: var(--text-light);
}
.nav-cta {
  background: var(--green);
  color: var(--white) !important;
  padding: 10px 24px;
  border-radius: 4px;
  font-weight: 600 !important;
  transition: background .2s;
}
.nav-cta:hover { background: var(--green-dark); }

@media (max-width: 900px) {
  .nav-links a:not(.lang-switch):not(.nav-cta) { display: none; }
  .nav-inner { height: 60px; }
  .logo { font-size: 18px; gap: 8px; }
  .logo-img { height: 32px; }
}
</style>
