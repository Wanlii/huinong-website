---
import Layout from '../../layouts/Layout.astro';
import { getAllProducts, getSpeciesByCategory } from '../../lib/products';

const products = getAllProducts();
const ornamentalSpecies = getSpeciesByCategory('ornamental');
const ornamentalCount = products.filter(p => p.category === 'ornamental').length;
const pottedCount = products.filter(p => p.category === 'potted').length;

// 按分类 + 物种分桶
const ornamentalProducts = products.filter(p => p.category === 'ornamental');
const pottedProducts = products.filter(p => p.category === 'potted');
const premiumProducts = pottedProducts.filter(p => p.subcategory === 'premium');
const miniProducts = pottedProducts.filter(p => p.subcategory === 'mini');

const sorted = [...products].sort((a, b) => {
  if (a.category === 'ornamental' && b.category !== 'ornamental') return -1;
  if (a.category !== 'ornamental' && b.category === 'ornamental') return 1;
  return a.order - b.order;
});
---
<Layout title="产品目录 - 汇农天下" lang="zh" description="汇农天下产品目录 - 观赏苗木、盆栽两大类，500+ 在售品种。">
  <section class="hero hero-short">
    <div class="hero-content">
      <h1>产品目录</h1>
      <p class="hero-sub">{products.length}+ 在售品种 · 持续更新 · 支持定制</p>
    </div>
  </section>

  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <!-- 一级分类 -->
      <div class="cat-filter" id="cat-filter">
        <button class="cat-filter-btn active" data-cat="all">全部产品</button>
        <button class="cat-filter-btn" data-cat="ornamental">观赏苗木</button>
        <button class="cat-filter-btn" data-cat="potted">盆栽</button>
      </div>

      <!-- 二级筛选: 观赏苗木 显示物种 -->
      <div class="sub-filter" id="species-filter" style="display: none;">
        <span class="sub-label">按物种：</span>
        {ornamentalSpecies.map(sp => (
          <button class="sub-btn" data-species={sp}>{sp}</button>
        ))}
      </div>

      <!-- 二级筛选: 盆栽 显示精品/小微 -->
      <div class="sub-filter" id="subcat-filter" style="display: none;">
        <span class="sub-label">按类型：</span>
        <button class="sub-btn" data-sub="premium">精品盆栽</button>
        <button class="sub-btn" data-sub="mini">小微盆栽</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="toolbar">
        <div class="search-wrap">
          <input type="search" id="search-input" class="search-input" placeholder="搜索产品（中文名 / 拉丁学名）" autocomplete="off" />
        </div>
        <span class="count">显示 <span id="visible-count">{sorted.length}</span> / 共 {products.length} 个产品</span>
      </div>

      <div class="product-grid" id="product-grid">
        {sorted.map(p => (
          <a href={`/products/${p.id}`} class="product-card"
             data-cat={p.category}
             data-subcat={p.subcategory}
             data-species={p.species}
             data-zhname={p.zhName}
             data-latin={p.latin}>
            <div class="product-img">
              {p.mainImage ? <img src={p.mainImage} alt={p.zhName} loading="lazy" /> : p.emoji}
            </div>
            <div class="product-info">
              <div class="product-name">{p.zhName}</div>
              <div class="product-latin">{p.latin}</div>
            </div>
          </a>
        ))}
      </div>

      <div id="empty-state" style="display: none; text-align: center; padding: 60px 0; color: var(--text-light);">
        <div style="font-size: 48px; margin-bottom: 12px;">🔍</div>
        <p>没找到匹配的产品，试试别的关键词或分类。</p>
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <h2>找不到想要的产品？</h2>
      <p>告诉我们您的需求，我们帮您找</p>
      <a href="/contact" class="btn-white">📩 立即询盘</a>
    </div>
  </section>
</Layout>

<style>
.cat-filter { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
.cat-filter-btn {
  background: var(--white); border: 1px solid var(--cream-dark);
  padding: 8px 18px; border-radius: 20px;
  cursor: pointer; font-size: 14px;
  transition: all .2s;
}
.cat-filter-btn.active { background: var(--green); color: var(--white); border-color: var(--green); }

.sub-filter {
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  justify-content: center; margin-bottom: 24px; max-width: 900px; margin-left: auto; margin-right: auto;
}
.sub-label { font-size: 13px; color: var(--text-light); margin-right: 4px; }
.sub-btn {
  background: var(--white); border: 1px solid var(--cream-dark);
  padding: 4px 12px; border-radius: 14px;
  cursor: pointer; font-size: 13px;
  transition: all .2s;
}
.sub-btn.active { background: var(--green); color: var(--white); border-color: var(--green); }

.toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 16px; flex-wrap: wrap; }
.search-wrap { flex: 1; min-width: 240px; max-width: 400px; }
.search-input {
  width: 100%; padding: 10px 14px;
  border: 1px solid var(--cream-dark); border-radius: 6px;
  font-size: 14px; font-family: inherit; background: var(--white);
  transition: border-color .2s;
}
.search-input:focus { outline: none; border-color: var(--green); }
.toolbar .count { color: var(--text-light); font-size: 14px; white-space: nowrap; }

.product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.product-card {
  background: var(--white); border-radius: 8px; overflow: hidden;
  box-shadow: var(--shadow);
  transition: transform .2s, box-shadow .2s;
}
.product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.product-img {
  width: 100%; height: 180px;
  background: linear-gradient(135deg, #d4c4a8 0%, #b8a888 100%);
  display: flex; align-items: center; justify-content: center;
  font-size: 50px; overflow: hidden;
}
.product-img img { width: 100%; height: 100%; object-fit: cover; }
.product-info { padding: 18px; }
.product-name { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.product-latin { font-size: 12px; color: var(--text-light); font-style: italic; }

@media (max-width: 900px) {
  .product-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .product-grid { grid-template-columns: 1fr; }
}
</style>

<script>
  const catFilter = document.getElementById('cat-filter')!;
  const speciesFilter = document.getElementById('species-filter')!;
  const subcatFilter = document.getElementById('subcat-filter')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const grid = document.getElementById('product-grid')!;
  const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];
  const visibleCount = document.getElementById('visible-count')!;
  const emptyState = document.getElementById('empty-state')!;

  let activeCat = 'all';
  let activeSpecies = '';
  let activeSub = '';
  let searchTerm = '';

  function applyFilters() {
    let n = 0;
    const term = searchTerm.trim().toLowerCase();
    for (const c of cards) {
      const cat = c.dataset.cat || '';
      const sp = c.dataset.species || '';
      const sub = c.dataset.subcat || '';
      const zh = (c.dataset.zhname || '').toLowerCase();
      const latin = (c.dataset.latin || '').toLowerCase();

      let ok = true;
      if (activeCat !== 'all' && cat !== activeCat) ok = false;
      if (ok && activeCat === 'ornamental' && activeSpecies && sp !== activeSpecies) ok = false;
      if (ok && activeCat === 'potted' && activeSub && sub !== activeSub) ok = false;
      if (ok && term && !zh.includes(term) && !latin.includes(term)) ok = false;

      c.style.display = ok ? '' : 'none';
      if (ok) n++;
    }
    visibleCount.textContent = String(n);
    emptyState.style.display = n === 0 ? 'block' : 'none';
  }

  // 一级分类
  catFilter.querySelectorAll('.cat-filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      catFilter.querySelectorAll('.cat-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = (btn as HTMLElement).dataset.cat || 'all';

      // 重置二级 + 显示对应二级
      activeSpecies = '';
      activeSub = '';
      speciesFilter.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('active'));
      subcatFilter.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('active'));
      speciesFilter.style.display = activeCat === 'ornamental' ? 'flex' : 'none';
      subcatFilter.style.display = activeCat === 'potted' ? 'flex' : 'none';

      applyFilters();
    });
  });

  // 物种
  speciesFilter.querySelectorAll('.sub-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isActive = btn.classList.contains('active');
      speciesFilter.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('active'));
      if (isActive) {
        activeSpecies = '';
      } else {
        btn.classList.add('active');
        activeSpecies = (btn as HTMLElement).dataset.species || '';
      }
      applyFilters();
    });
  });

  // 子分类
  subcatFilter.querySelectorAll('.sub-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isActive = btn.classList.contains('active');
      subcatFilter.querySelectorAll('.sub-btn').forEach(b => b.classList.remove('active'));
      if (isActive) {
        activeSub = '';
      } else {
        btn.classList.add('active');
        activeSub = (btn as HTMLElement).dataset.sub || '';
      }
      applyFilters();
    });
  });

  // 搜索
  searchInput.addEventListener('input', () => {
    searchTerm = searchInput.value;
    applyFilters();
  });
</script>
