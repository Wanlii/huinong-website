---
import Layout from '../../layouts/Layout.astro';
import {
  getProductsByCategory,
  getSpeciesByCategory,
  getSpeciesImages,
  getAllProducts,
  getPottedSubCategories,
  type Product,
  type SpeciesInfo,
} from '../../lib/products';

const allProducts = getAllProducts();
const ornamental = getProductsByCategory('ornamental');
const species = getSpeciesByCategory('ornamental');
const pottedSubs = getPottedSubCategories();
const allForSearch = allProducts.map(p => ({
  id: p.id, latin: p.latin, zh: p.zhName, en: p.enName, species: p.species,
  category: p.category, gallery: p.gallery,
}));

// 把所有图片按种属分组（用于筛选时的图集）
const speciesGallery: Record<string, string[]> = {};
for (const s of species) {
  speciesGallery[s.zh] = getSpeciesImages(s.zh);
}

// 搜索时按 拉丁+中文+英文 匹配
const searchIndex = allForSearch.map(p => ({
  ...p,
  haystack: `${p.latin} ${p.zh} ${p.en} ${p.species}`.toLowerCase(),
}));

// 传给 JS 用的简单值
const ornamentalCount = ornamental.length;
const allProductsCount = allProducts.length;
---
<Layout title="Product Catalog - Huinong" lang="en" description="Huinong product catalog - ornamental plants and bonsai. Browse 100+ varieties, search by Latin or Chinese name.">
  <section class="hero hero-short">
    <div class="hero-content">
      <h1>Product Catalog</h1>
      <p class="hero-sub">{allProducts.length}+ varieties across ornamental &amp; bonsai · continuously updated · custom orders welcome</p>
    </div>
  </section>

  <section class="section" style="padding-bottom: 0;">
    <div class="container">
      <!-- Category tabs -->
      <div class="cat-tabs" id="cat-tabs">
        <button class="cat-tab active" data-cat="all">All</button>
        <button class="cat-tab" data-cat="ornamental">Ornamental</button>
        <a class="cat-tab" href="/products/potted">Potted</a>
      </div>

      <!-- Search + chips (chips only shown for ornamental tab) -->
      <div class="filter-bar" id="filter-bar" style="display: none;">
        <div class="search-wrap">
          <input type="search" id="search-input" class="search-input" placeholder="Search (Latin / English / 中文)" autocomplete="off" />
        </div>
        <div class="chips" id="chips">
          <button class="chip active" data-species="">All Species</button>
          {species.map(s => (
            <button class="chip" data-species={s.zh}>
              <span class="chip-latin">{s.latin}</span>
              <span class="chip-zh">{s.zh}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Results header (back button shown in gallery mode) -->
      <div class="results-header" id="results-header">
        <button id="back-btn" class="back-btn" style="display: none;">← Back to list</button>
        <span class="count" id="result-count">{allProducts.length} products</span>
      </div>

      <!-- All tab: 全部产品卡片（默认） -->
      <div class="product-grid" id="grid-all">
        {ornamental.map(p => (
          <a href={`/products/ornamental/${p.id}`} class="product-card"
             data-id={p.id}
             data-species={p.species}>
            <div class="product-img">
              {p.mainImage ? <img src={p.mainImage} alt={`${p.latin} (${p.zhName})`} loading="lazy" /> : p.emoji}
            </div>
            <div class="product-info">
              <div class="product-name">{p.latin}</div>
              <div class="product-zh">{p.zhName}</div>
            </div>
          </a>
        ))}
      </div>

      <!-- Potted sub-categories as 2 cards (instead of 21 individual products) -->
      <div class="potted-section" id="potted-subs">
        <div class="section-header" style="text-align: left; margin-bottom: 16px; margin-top: 40px;">
          <h2 style="font-size: 22px; margin-bottom: 4px;">Potted (Bonsai)</h2>
          <p style="font-size: 14px; color: var(--text-light); margin: 0;">Two curated categories</p>
        </div>
        <div class="potted-grid">
          {pottedSubs.map(sub => (
            <a href={`/products/potted/${sub.slug}`} class="product-card subcat-card">
              <div class="product-img" style={sub.cover ? `background-image: url('${sub.cover}');` : ''}></div>
              <div class="product-info">
                <div class="product-name">{sub.en}</div>
                <div class="product-zh">{sub.zh} · {sub.count} photos</div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Ornamental tab: 观赏苗木卡片 + chips筛选 -->
      <div id="ornamental-section" style="display: none;">
        <div class="product-grid" id="product-grid" data-mode="cards">
          {ornamental.map(p => (
            <a href={`/products/ornamental/${p.id}`} class="product-card"
               data-id={p.id}
               data-species={p.species}>
              <div class="product-img">
                {p.mainImage ? <img src={p.mainImage} alt={`${p.latin} (${p.zhName})`} loading="lazy" /> : p.emoji}
              </div>
              <div class="product-info">
                <div class="product-name">{p.latin}</div>
                <div class="product-zh">{p.zhName}</div>
              </div>
            </a>
          ))}
        </div>
        <div class="gallery-grid" id="gallery-grid" style="display: none;"></div>
      </div>

      <div id="empty-state" style="display: none; text-align: center; padding: 60px 0; color: var(--text-light);">
        <div style="font-size: 48px; margin-bottom: 12px;">🔍</div>
        <p>No matching products. Try a different keyword or species.</p>
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <h2>Need custom sourcing?</h2>
      <p>Tell us your requirements and we'll source it for you</p>
      <a href="/contact" class="btn-white">📩 Request a Quote</a>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" style="display: none;">
    <button class="lb-close" aria-label="Close">×</button>
    <button class="lb-prev" aria-label="Previous">‹</button>
    <button class="lb-next" aria-label="Next">›</button>
    <img id="lb-img" src="" alt="" />
    <div class="lb-counter" id="lb-counter"></div>
  </div>
</Layout>

<style>
.hero-short { height: 280px; }
.hero {
  position: relative;
  height: 480px;
  overflow: hidden;
  background: linear-gradient(135deg, #3A5F3A 0%, #2A4A2A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-content {
  position: relative; z-index: 2; text-align: center;
  color: var(--white); max-width: 800px; padding: 0 24px;
}
.hero h1 { font-size: 40px; line-height: 1.2; margin-bottom: 12px; }
.hero-sub { font-size: 16px; opacity: 0.9; }
@media (max-width: 900px) {
  .hero-short { height: 200px; }
  .hero h1 { font-size: 28px; }
}

.section { padding: 56px 0; }
.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

.cat-tabs { display: flex; justify-content: center; gap: 8px; margin-bottom: 28px; }
.cat-tab {
  background: var(--white);
  border: 1px solid var(--cream-dark);
  padding: 10px 24px;
  border-radius: 24px;
  font-size: 14px;
  font-weight: 500;
  color: var(--text);
  cursor: pointer;
  text-decoration: none;
  transition: all .2s;
  display: inline-block;
}
.cat-tab.active, .cat-tab:hover {
  background: var(--green);
  color: var(--white);
  border-color: var(--green);
}

.filter-bar { max-width: 900px; margin: 0 auto 32px; }
.search-wrap { margin-bottom: 16px; }
.search-input {
  width: 100%; padding: 12px 16px;
  border: 1px solid var(--cream-dark); border-radius: 8px;
  font-size: 14px; font-family: inherit; background: var(--white);
  transition: border-color .2s;
}
.search-input:focus { outline: none; border-color: var(--green); }

.chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
.chip {
  background: var(--white);
  border: 1px solid var(--cream-dark);
  padding: 6px 14px;
  border-radius: 18px;
  cursor: pointer;
  font-size: 13px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: all .2s;
  font-family: inherit;
  color: var(--text);
}
.chip:hover { border-color: var(--green); }
.chip.active {
  background: var(--green);
  color: var(--white);
  border-color: var(--green);
}
.chip-latin { font-style: italic; }
.chip-zh { font-weight: 500; }

.results-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 16px;
  flex-wrap: wrap;
}
.count { color: var(--text-light); font-size: 14px; }
.back-btn {
  background: transparent;
  border: 1px solid var(--green);
  color: var(--green);
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: all .2s;
  font-family: inherit;
}
.back-btn:hover { background: var(--green); color: var(--white); }

.product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.product-card {
  background: var(--white); border-radius: 8px; overflow: hidden;
  box-shadow: var(--shadow);
  transition: transform .2s, box-shadow .2s;
  display: block; color: inherit;
}
.product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.product-img {
  width: 100%; aspect-ratio: 1;
  background: linear-gradient(135deg, #d4c4a8 0%, #b8a888 100%);
  display: flex; align-items: center; justify-content: center;
  font-size: 50px; overflow: hidden;
}
.product-img img { width: 100%; height: 100%; object-fit: cover; }
.product-info { padding: 18px; }
.product-name { font-size: 15px; font-weight: 600; margin-bottom: 4px; font-style: italic; }
.product-zh { font-size: 13px; color: var(--text-light); }

@media (max-width: 900px) { .product-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 500px) { .product-grid { grid-template-columns: 1fr; } }

.potted-section { margin-top: 24px; padding-top: 32px; border-top: 1px solid var(--cream-dark); }
.potted-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.subcat-card .product-img {
  background-color: var(--cream-dark);
  background-size: cover;
  background-position: center;
}
@media (max-width: 600px) { .potted-grid { grid-template-columns: 1fr; } }

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 8px;
  align-items: start;
}
.gallery-grid :global(.gallery-item) {
  display: block;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 4px;
  background: var(--cream-dark);
  cursor: zoom-in;
}
.gallery-grid :global(.gallery-item img) {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .3s, opacity .2s;
}
.gallery-grid :global(.gallery-item:hover img) { transform: scale(1.05); opacity: 0.9; }

.cta-strip { background: var(--wood); padding: 56px 0; text-align: center; color: var(--white); }
.cta-strip h2 { font-size: 28px; margin-bottom: 12px; }
.cta-strip p { font-size: 15px; opacity: 0.9; margin-bottom: 28px; }
.btn-white {
  display: inline-block; background: var(--white);
  color: var(--wood) !important; padding: 14px 36px;
  border-radius: 4px; font-weight: 700; font-size: 16px;
  transition: transform .2s; cursor: pointer;
}
.btn-white:hover { transform: scale(1.03); }

.lightbox {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.92);
  z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
}
.lightbox img {
  max-width: 90vw; max-height: 85vh;
  object-fit: contain;
  box-shadow: 0 4px 24px rgba(0,0,0,0.5);
}
.lb-close, .lb-prev, .lb-next {
  position: absolute;
  background: rgba(255,255,255,0.1);
  color: var(--white);
  border: none;
  font-size: 32px;
  line-height: 1;
  width: 56px; height: 56px;
  border-radius: 50%;
  cursor: pointer;
  transition: background .2s;
}
.lb-close:hover, .lb-prev:hover, .lb-next:hover { background: rgba(255,255,255,0.25); }
.lb-close { top: 24px; right: 24px; font-size: 40px; }
.lb-prev { left: 24px; top: 50%; transform: translateY(-50%); }
.lb-next { right: 24px; top: 50%; transform: translateY(-50%); }
.lb-counter {
  position: absolute; bottom: 24px; left: 50%;
  transform: translateX(-50%);
  color: var(--white); font-size: 14px;
  background: rgba(0,0,0,0.5);
  padding: 6px 16px; border-radius: 14px;
}
</style>

<script define:vars={{ speciesGallery, searchIndex, ornamentalCount, allProductsCount }}>
  const tabs = document.querySelectorAll('#cat-tabs .cat-tab[data-cat]');
  const filterBar = document.getElementById('filter-bar');
  const gridAll = document.getElementById('grid-all');
  const ornamentalSection = document.getElementById('ornamental-section');
  const cards = document.getElementById('product-grid');
  const gallery = document.getElementById('gallery-grid');
  const backBtn = document.getElementById('back-btn');
  const countEl = document.getElementById('result-count');
  const emptyState = document.getElementById('empty-state');
  const searchInput = document.getElementById('search-input');
  const chipsContainer = document.getElementById('chips');
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbCounter = document.getElementById('lb-counter');
  const btnClose = lightbox && lightbox.querySelector('.lb-close');
  const btnPrev = lightbox && lightbox.querySelector('.lb-prev');
  const btnNext = lightbox && lightbox.querySelector('.lb-next');

  let activeTab = 'all';
  let activeSpecies = '';
  let searchTerm = '';
  let currentImages = [];
  let lbIndex = 0;

  function switchTab(tab) {
    activeTab = tab;
    tabs.forEach(function(b){
      if (b.getAttribute('data-cat') === tab) b.classList.add('active');
      else b.classList.remove('active');
    });
    if (tab === 'all') {
      filterBar.style.display = 'none';
      gridAll.style.display = '';
      ornamentalSection.style.display = 'none';
      countEl.textContent = ornamentalCount + ' ornamental + 2 potted categories';
      resetOrnamental();
    } else if (tab === 'ornamental') {
      filterBar.style.display = '';
      gridAll.style.display = 'none';
      ornamentalSection.style.display = '';
      countEl.textContent = ornamentalCount + ' products';
      renderOrnamental();
    }
  }

  function isFiltering() {
    return activeSpecies !== '' || (searchTerm && searchTerm.trim() !== '');
  }

  function renderOrnamental() {
    if (!isFiltering()) {
      cards.style.display = '';
      gallery.style.display = 'none';
      backBtn.style.display = 'none';
      emptyState.style.display = 'none';
      countEl.textContent = ornamentalCount + ' products';
      return;
    }
    let matchedSpecies = [];
    if (activeSpecies) {
      matchedSpecies = [activeSpecies];
    } else {
      const term = searchTerm.trim().toLowerCase();
      const matchedIds = new Set();
      for (const item of searchIndex) {
        if (item.category === 'ornamental' && item.haystack.indexOf(term) !== -1) matchedIds.add(item.id);
      }
      const matchedZh = new Set();
      for (const item of searchIndex) {
        if (matchedIds.has(item.id)) matchedZh.add(item.species);
      }
      matchedSpecies = Array.from(matchedZh);
    }

    const allImages = [];
    const seen = new Set();
    for (const sp of matchedSpecies) {
      const imgs = speciesGallery[sp] || [];
      for (const img of imgs) {
        if (!seen.has(img)) { seen.add(img); allImages.push(img); }
      }
    }

    if (allImages.length === 0) {
      cards.style.display = 'none';
      gallery.style.display = 'none';
      backBtn.style.display = '';
      emptyState.style.display = '';
      countEl.textContent = '0 photos';
      return;
    }

    currentImages = allImages;
    cards.style.display = 'none';
    gallery.style.display = '';
    backBtn.style.display = '';
    emptyState.style.display = 'none';

    const spLabel = matchedSpecies.length === 1 ? matchedSpecies[0] : (matchedSpecies.length + ' species');
    countEl.textContent = allImages.length + ' photos · ' + spLabel;

    gallery.innerHTML = allImages.map(function(src, i){
      return '<a href="' + src + '" class="gallery-item" data-index="' + i + '" data-src="' + src + '">' +
        '<img src="' + src + '" alt="Photo ' + (i+1) + '" loading="lazy" />' +
      '</a>';
    }).join('');

    gallery.querySelectorAll('.gallery-item').forEach(function(el){
      el.addEventListener('click', function(e){
        e.preventDefault();
        const idx = parseInt(el.getAttribute('data-index') || '0', 10);
        openLb(idx);
      });
    });
  }

  function resetOrnamental() {
    activeSpecies = '';
    searchTerm = '';
    if (searchInput) searchInput.value = '';
    if (chipsContainer) {
      chipsContainer.querySelectorAll('.chip').forEach(function(c){ c.classList.remove('active'); });
      chipsContainer.querySelector('.chip[data-species=""]').classList.add('active');
    }
  }

  function openLb(i) {
    if (!lightbox) return;
    lbIndex = i;
    updateLb();
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  function closeLb() {
    if (!lightbox) return;
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }
  function updateLb() {
    if (!lbImg || !lbCounter) return;
    lbImg.src = currentImages[lbIndex] || '';
    lbCounter.textContent = (lbIndex + 1) + ' / ' + currentImages.length;
  }
  function nextLb() { lbIndex = (lbIndex + 1) % currentImages.length; updateLb(); }
  function prevLb() { lbIndex = (lbIndex - 1 + currentImages.length) % currentImages.length; updateLb(); }

  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      const cat = t.getAttribute('data-cat');
      if (cat) switchTab(cat);
    });
  });

  if (chipsContainer) {
    chipsContainer.addEventListener('click', function(e) {
      const btn = e.target.closest('.chip');
      if (!btn) return;
      chipsContainer.querySelectorAll('.chip').forEach(function(c){ c.classList.remove('active'); });
      btn.classList.add('active');
      activeSpecies = btn.getAttribute('data-species') || '';
      searchInput.value = '';
      searchTerm = '';
      renderOrnamental();
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', function() {
      searchTerm = searchInput.value;
      if (searchTerm.trim() !== '') {
        chipsContainer.querySelectorAll('.chip').forEach(function(c){ c.classList.remove('active'); });
        activeSpecies = '';
      } else {
        chipsContainer.querySelector('.chip[data-species=""]').classList.add('active');
      }
      renderOrnamental();
    });
  }

  if (backBtn) backBtn.addEventListener('click', resetOrnamental);

  if (btnClose) btnClose.addEventListener('click', closeLb);
  if (btnNext) btnNext.addEventListener('click', nextLb);
  if (btnPrev) btnPrev.addEventListener('click', prevLb);
  if (lightbox) lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLb(); });
  document.addEventListener('keydown', function(e) {
    if (!lightbox || lightbox.style.display !== 'flex') return;
    if (e.key === 'Escape') closeLb();
    else if (e.key === 'ArrowRight') nextLb();
    else if (e.key === 'ArrowLeft') prevLb();
  });
</script>
</Layout>
