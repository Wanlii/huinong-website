---
import Layout from '../../../layouts/Layout.astro';
import { getPottedSubCategory, getPottedSubCategories, getPottedGallery } from '../../../lib/products';

export function getStaticPaths() {
  return getPottedSubCategories().map(sub => ({ params: { slug: sub.slug } }));
}

const { slug } = Astro.params;
const info = getPottedSubCategory(slug!);
if (!info) {
  throw new Error(`Unknown potted subcategory: ${slug}`);
}
const gallery = getPottedGallery(slug!);
const otherSubs = getPottedSubCategories().filter(s => s.slug !== slug);

const titleEn = `${info.en} - ${info.zh} Gallery - Huinong`;
const descEn = `${info.enDesc}. ${info.count} photos. Source factory direct.`;
---
<Layout title={titleEn} lang="en" description={descEn}>
  <div class="breadcrumb">
    <div class="container">
      <a href="/">Home</a> › <a href="/products">Catalog</a> › <a href="/products/potted">Potted</a> › <span>{info.en}</span>
    </div>
  </div>

  <section class="cat-hero" style={info.cover ? `background-image: linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.35)), url('${info.cover}');` : ''}>
    <div class="container">
      <h1>{info.en}</h1>
      <p class="cat-hero-sub">{info.enDesc}</p>
      <p class="cat-hero-count">{info.count} photos in gallery</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {gallery.length === 0 ? (
        <p style="text-align: center; color: var(--text-light); padding: 60px 0;">No photos available yet.</p>
      ) : (
        <div class="gallery-grid">
          {gallery.map((src, i) => (
            <a href={src} class="gallery-item" data-index={i} data-src={src}>
              <img src={src} alt={`${info.en} photo ${i+1}`} loading="lazy" />
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  {otherSubs.length > 0 && (
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div class="section-header" style="text-align: left; margin-bottom: 24px;">
          <h2 style="font-size: 22px; margin-bottom: 0;">Other Subcategories</h2>
        </div>
        <div class="other-grid">
          {otherSubs.map(s => (
            <a href={`/products/potted/${s.slug}`} class="other-card">
              <div class="other-img" style={s.cover ? `background-image: url('${s.cover}');` : ''}></div>
              <div class="other-body">
                <h3>{s.en}</h3>
                <span>{s.count} photos →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cta-strip">
    <div class="container">
      <h2>Interested in {info.en}?</h2>
      <p>Tell us quantity, size and destination. We'll reply within 12 hours.</p>
      <a href={`/contact?category=potted-${info.slug}`} class="btn-white">📩 Request a Quote</a>
    </div>
  </section>

  <div id="lightbox" class="lightbox" style="display: none;">
    <button class="lb-close" aria-label="Close">×</button>
    <button class="lb-prev" aria-label="Previous">‹</button>
    <button class="lb-next" aria-label="Next">›</button>
    <img id="lb-img" src="" alt="" />
    <div class="lb-counter" id="lb-counter"></div>
  </div>
</Layout>

<style>
.breadcrumb {
  background: var(--cream);
  padding: 14px 0;
  font-size: 13px;
  color: var(--text-light);
  border-bottom: 1px solid var(--cream-dark);
}
.breadcrumb a { color: var(--green); }
.breadcrumb a:hover { text-decoration: underline; }
.breadcrumb span { color: var(--text); }

.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

.cat-hero {
  background-color: #2A4A2A;
  background-size: cover;
  background-position: center;
  color: var(--white);
  padding: 80px 0;
  text-align: center;
}
.cat-hero h1 { font-size: 44px; margin-bottom: 12px; }
.cat-hero-sub { font-size: 16px; opacity: 0.9; margin-bottom: 8px; }
.cat-hero-count { font-size: 14px; opacity: 0.7; }
@media (max-width: 900px) {
  .cat-hero { padding: 56px 0; }
  .cat-hero h1 { font-size: 30px; }
}

.section { padding: 56px 0; }
.section-header h2 { font-size: 22px; color: var(--text); }

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.gallery-item {
  display: block;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 6px;
  background: var(--cream-dark);
  cursor: zoom-in;
}
.gallery-item img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform .4s, opacity .2s;
}
.gallery-item:hover img { transform: scale(1.05); opacity: 0.9; }

@media (max-width: 900px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 500px) { .gallery-grid { grid-template-columns: 1fr; } }

.other-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.other-card {
  display: flex; background: var(--white);
  border-radius: 8px; overflow: hidden;
  box-shadow: var(--shadow);
  transition: box-shadow .3s, transform .3s;
  color: inherit;
}
.other-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.other-img { width: 120px; height: 100px; background-size: cover; background-position: center; flex-shrink: 0; }
.other-body { padding: 12px 16px; display: flex; flex-direction: column; justify-content: center; }
.other-body h3 { font-size: 16px; color: var(--green); margin-bottom: 4px; }
.other-body span { font-size: 13px; color: var(--text-light); }
@media (max-width: 600px) {
  .other-grid { grid-template-columns: 1fr; }
  .other-card { max-width: 320px; }
}

.cta-strip { background: var(--wood); padding: 56px 0; text-align: center; color: var(--white); }
.cta-strip h2 { font-size: 28px; margin-bottom: 12px; }
.cta-strip p { font-size: 15px; opacity: 0.9; margin-bottom: 28px; }
.btn-white {
  display: inline-block; background: var(--white);
  color: var(--wood) !important; padding: 14px 36px;
  border-radius: 4px; font-weight: 700; font-size: 16px;
  transition: transform .2s; cursor: pointer;
}
.btn-white:hover { transform: scale(1.03); }

.lightbox {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.92);
  z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
}
.lightbox img {
  max-width: 90vw; max-height: 85vh;
  object-fit: contain;
  box-shadow: 0 4px 24px rgba(0,0,0,0.5);
}
.lb-close, .lb-prev, .lb-next {
  position: absolute;
  background: rgba(255,255,255,0.1);
  color: var(--white);
  border: none;
  font-size: 32px;
  line-height: 1;
  width: 56px; height: 56px;
  border-radius: 50%;
  cursor: pointer;
  transition: background .2s;
}
.lb-close:hover, .lb-prev:hover, .lb-next:hover { background: rgba(255,255,255,0.25); }
.lb-close { top: 24px; right: 24px; font-size: 40px; }
.lb-prev { left: 24px; top: 50%; transform: translateY(-50%); }
.lb-next { right: 24px; top: 50%; transform: translateY(-50%); }
.lb-counter {
  position: absolute; bottom: 24px; left: 50%;
  transform: translateX(-50%);
  color: var(--white); font-size: 14px;
  background: rgba(0,0,0,0.5);
  padding: 6px 16px; border-radius: 14px;
}
</style>

<script>
  const gallery = Array.from(document.querySelectorAll('.gallery-item')) as HTMLAnchorElement[];
  const lightbox = document.getElementById('lightbox') as HTMLDivElement;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('lb-counter') as HTMLDivElement;
  const btnClose = lightbox.querySelector('.lb-close') as HTMLButtonElement;
  const btnPrev = lightbox.querySelector('.lb-prev') as HTMLButtonElement;
  const btnNext = lightbox.querySelector('.lb-next') as HTMLButtonElement;

  let currentIndex = 0;
  const total = gallery.length;

  function open(i: number) {
    currentIndex = i;
    update();
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  function close() {
    lightbox.style.display = 'none';
    document.body.style.overflow = '';
  }
  function update() {
    const item = gallery[currentIndex];
    if (!item) return;
    lbImg.src = item.dataset.src || '';
    lbImg.alt = item.querySelector('img')?.alt || '';
    lbCounter.textContent = `${currentIndex + 1} / ${total}`;
  }
  function next() { currentIndex = (currentIndex + 1) % total; update(); }
  function prev() { currentIndex = (currentIndex - 1 + total) % total; update(); }

  gallery.forEach((item, i) => {
    item.addEventListener('click', (e) => { e.preventDefault(); open(i); });
  });
  btnClose.addEventListener('click', close);
  btnNext.addEventListener('click', next);
  btnPrev.addEventListener('click', prev);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
  document.addEventListener('keydown', (e) => {
    if (lightbox.style.display !== 'flex') return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowRight') next();
    else if (e.key === 'ArrowLeft') prev();
  });
</script>
