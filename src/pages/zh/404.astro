---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="404 - 页面未找到" lang="zh" description="您访问的页面不存在。">
  <section class="section">
    <div class="container" style="text-align: center; padding: 80px 24px;">
      <h1 style="font-size: 96px; color: var(--green); margin-bottom: 16px; line-height: 1;">404</h1>
      <h2 style="font-size: 24px; margin-bottom: 16px;">页面未找到</h2>
      <p style="font-size: 16px; color: var(--text-light); margin: 16px auto 32px; max-width: 480px;">您访问的页面不存在或已被移动。</p>
      <a href="/zh/" class="btn-green">返回首页</a>
    </div>
  </section>
</Layout>
