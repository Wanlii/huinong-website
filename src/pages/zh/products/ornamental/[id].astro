---
import Layout from '../../../../layouts/Layout.astro';
import { getAllProducts, getSpeciesImages } from '../../../../lib/products';

export function getStaticPaths() {
  return getAllProducts()
    .filter(p => p.category === 'ornamental')
    .map(p => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const product = getAllProducts().find(p => p.id === id);
if (!product) {
  throw new Error(`Product not found: ${id}`);
}

const otherSpeciesImages = getSpeciesImages(product.species)
  .filter(src => !product.gallery.includes(src));

const titleZh = `${product.zhName}（${product.latin}）- 汇农天下`;
const descZh = `${product.shortDesc || product.zhName} - 源头工厂直供，欧盟认证。`;
---
<Layout title={titleZh} lang="zh" description={descZh}>
  <div class="breadcrumb">
    <div class="container">
      <a href="/zh/">首页</a> › <a href="/zh/products">产品目录</a> › <a href="/zh/products?cat=ornamental">观赏苗木</a> › <span>{product.zhName}</span>
    </div>
  </div>

  {product.gallery.length > 0 ? (
    <>
      <section class="section" style="padding-top: 32px;">
        <div class="container">
          <div class="pd-grid">
            <div class="pd-gallery">
              <div class="pd-main">
                <img id="pd-main-img" src={product.mainImage} alt={`${product.latin}（${product.zhName}）`} />
              </div>
              {product.gallery.length > 1 && (
                <div class="pd-thumbs">
                  {product.gallery.map((img, i) => (
                    <div class={`pd-thumb ${i === 0 ? 'active' : ''}`} data-image={img}>
                      <img src={img} alt={`${product.zhName} ${i+1}`} loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div class="pd-info">
              <h1 class="latin-main">{product.latin}</h1>
              <p class="zh-sub">{product.zhName}</p>
              <div class="meta-row">
                <span class="meta-label">高度：</span>
                <span class="meta-value">{product.height || '—'}</span>
              </div>
              <div class="meta-row">
                <span class="meta-label">起订量：</span>
                <span class="meta-value">{product.moq || '—'}</span>
              </div>
              {product.shortDesc && <div class="short-desc">{product.shortDesc}</div>}
              <div class="pd-actions">
                <a href={`/zh/contact?product=${encodeURIComponent(product.latin)}`} class="btn-green" style="flex: 1; text-align: center;">📩 立即询盘</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      {product.longDesc && (
        <section class="section" style="padding-top: 0;">
          <div class="container">
            <div class="pd-content">
              <h3 class="pd-h3">品种介绍</h3>
              <div class="long-desc">{product.longDesc}</div>
            </div>
          </div>
        </section>
      )}

      {otherSpeciesImages.length > 0 && (
        <section class="section" style="padding-top: 0;">
          <div class="container">
            <div class="section-header" style="text-align: left; margin-bottom: 24px;">
              <h2 style="font-size: 22px; margin-bottom: 0;">更多 {product.species}</h2>
            </div>
            <div class="more-grid">
              {otherSpeciesImages.slice(0, 12).map((src, i) => (
                <a href={src} class="more-item" data-src={src} data-index={i}>
                  <img src={src} alt={`${product.species} ${i+1}`} loading="lazy" />
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="section">
      <div class="container">
        <div class="empty">
          <h1 class="latin-main">{product.latin}</h1>
          <p class="zh-sub">{product.zhName}</p>
          <p>图片整理中，请直接联系我们了解详情。</p>
          <a href={`/zh/contact?product=${encodeURIComponent(product.latin)}`} class="btn-green">📩 立即询盘</a>
        </div>
      </div>
    </section>
  )}

  <section class="cta-strip">
    <div class="container">
      <h2>需要批量采购{product.zhName}？</h2>
      <p>告诉我们数量、规格和目的地，12 小时内回复</p>
      <a href={`/zh/contact?product=${encodeURIComponent(product.latin)}`} class="btn-white">📩 立即询盘</a>
    </div>
  </section>

  <div id="lightbox" class="lightbox" style="display: none;">
    <button class="lb-close" aria-label="关闭">×</button>
    <button class="lb-prev" aria-label="上一张">‹</button>
    <button class="lb-next" aria-label="下一张">›</button>
    <img id="lb-img" src="" alt="" />
    <div class="lb-counter" id="lb-counter"></div>
  </div>
</Layout>

<style>
.breadcrumb {
  background: var(--cream);
  padding: 14px 0;
  font-size: 13px;
  color: var(--text-light);
  border-bottom: 1px solid var(--cream-dark);
}
.breadcrumb a { color: var(--green); }
.breadcrumb a:hover { text-decoration: underline; }
.breadcrumb span { color: var(--text); }

.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

.section { padding: 56px 0; }

.pd-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 48px;
}
@media (max-width: 900px) { .pd-grid { grid-template-columns: 1fr; gap: 24px; } }

.pd-main {
  background: var(--cream-dark);
  border-radius: 8px;
  overflow: hidden;
  aspect-ratio: 1;
  display: flex; align-items: center; justify-content: center;
}
.pd-main img { width: 100%; height: 100%; object-fit: cover; }

.pd-thumbs {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 6px;
  margin-top: 8px;
}
.pd-thumb {
  aspect-ratio: 1;
  border-radius: 4px;
  overflow: hidden;
  cursor: pointer;
  background: var(--cream-dark);
  border: 2px solid transparent;
  transition: border-color .2s;
}
.pd-thumb img { width: 100%; height: 100%; object-fit: cover; }
.pd-thumb.active { border-color: var(--green); }
.pd-thumb:hover { border-color: var(--green-light, #88aa88); }

.pd-info { padding: 8px 0; }
.latin-main { font-size: 32px; color: var(--text); margin-bottom: 8px; font-style: italic; }
.zh-sub { font-size: 18px; color: var(--text-light); margin-bottom: 20px; }
.meta-row { display: flex; gap: 8px; margin-bottom: 8px; font-size: 14px; }
.meta-label { color: var(--text-light); min-width: 70px; }
.meta-value { color: var(--text); font-weight: 500; }
.short-desc {
  margin: 16px 0 24px;
  padding: 16px;
  background: var(--cream);
  border-radius: 6px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text);
}
.pd-actions { display: flex; gap: 12px; }
.btn-green {
  display: inline-block;
  background: var(--green);
  color: var(--white) !important;
  padding: 14px 24px;
  border-radius: 4px;
  font-weight: 600;
  text-align: center;
}
.btn-green:hover { background: var(--green-dark); }

.pd-content { max-width: 880px; }
.pd-h3 { font-size: 20px; margin-bottom: 12px; color: var(--text); }
.long-desc { font-size: 15px; line-height: 1.8; color: var(--text); }

.more-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
}
.more-item {
  display: block;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 4px;
  background: var(--cream-dark);
  cursor: zoom-in;
}
.more-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.more-item:hover img { transform: scale(1.05); }
@media (max-width: 900px) { .more-grid { grid-template-columns: repeat(3, 1fr); } }

.empty { text-align: center; padding: 80px 20px; }
.empty .latin-main { font-size: 28px; margin-bottom: 8px; }
.empty p { margin: 12px 0 24px; color: var(--text-light); }

.cta-strip { background: var(--wood); padding: 56px 0; text-align: center; color: var(--white); }
.cta-strip h2 { font-size: 28px; margin-bottom: 12px; }
.cta-strip p { font-size: 15px; opacity: 0.9; margin-bottom: 28px; }
.btn-white {
  display: inline-block; background: var(--white);
  color: var(--wood) !important; padding: 14px 36px;
  border-radius: 4px; font-weight: 700; font-size: 16px;
}
.btn-white:hover { transform: scale(1.03); }

.lightbox {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0.92);
  z-index: 9999;
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
}
.lightbox img {
  max-width: 90vw; max-height: 85vh;
  object-fit: contain;
}
.lb-close, .lb-prev, .lb-next {
  position: absolute;
  background: rgba(255,255,255,0.1);
  color: var(--white);
  border: none;
  font-size: 32px;
  line-height: 1;
  width: 56px; height: 56px;
  border-radius: 50%;
  cursor: pointer;
}
.lb-close { top: 24px; right: 24px; font-size: 40px; }
.lb-prev { left: 24px; top: 50%; transform: translateY(-50%); }
.lb-next { right: 24px; top: 50%; transform: translateY(-50%); }
.lb-counter {
  position: absolute; bottom: 24px; left: 50%;
  transform: translateX(-50%);
  color: var(--white); font-size: 14px;
  background: rgba(0,0,0,0.5);
  padding: 6px 16px; border-radius: 14px;
}
</style>

<script define:vars={{ productGallery: product.gallery, otherImages: otherSpeciesImages }}>
  const allImages = productGallery.concat(otherImages);
  const mainImg = document.getElementById('pd-main-img');
  const thumbs = document.querySelectorAll('.pd-thumb');
  const moreItems = document.querySelectorAll('.more-item');
  const lightbox = document.getElementById('lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbCounter = document.getElementById('lb-counter');
  const btnClose = lightbox.querySelector('.lb-close');
  const btnPrev = lightbox.querySelector('.lb-prev');
  const btnNext = lightbox.querySelector('.lb-next');
  let lbIndex = 0;

  thumbs.forEach((t, i) => {
    t.addEventListener('click', () => {
      thumbs.forEach(x => x.classList.remove('active'));
      t.classList.add('active');
      if (mainImg) mainImg.src = t.getAttribute('data-image');
    });
  });

  function openLb(i) {
    lbIndex = i;
    updateLb();
    lightbox.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
  function closeLb() { lightbox.style.display = 'none'; document.body.style.overflow = ''; }
  function updateLb() {
    if (!lbImg || !lbCounter) return;
    lbImg.src = allImages[lbIndex] || '';
    lbCounter.textContent = (lbIndex + 1) + ' / ' + allImages.length;
  }
  function nextLb() { lbIndex = (lbIndex + 1) % allImages.length; updateLb(); }
  function prevLb() { lbIndex = (lbIndex - 1 + allImages.length) % allImages.length; updateLb(); }

  thumbs.forEach((t, i) => { t.addEventListener('dblclick', () => openLb(i)); });
  moreItems.forEach((m, i) => {
    m.addEventListener('click', (e) => { e.preventDefault(); openLb(productGallery.length + i); });
  });
  if (mainImg) {
    mainImg.addEventListener('click', () => openLb(0));
    mainImg.style.cursor = 'zoom-in';
  }

  btnClose.addEventListener('click', closeLb);
  btnNext.addEventListener('click', nextLb);
  btnPrev.addEventListener('click', prevLb);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLb(); });
  document.addEventListener('keydown', (e) => {
    if (lightbox.style.display !== 'flex') return;
    if (e.key === 'Escape') closeLb();
    else if (e.key === 'ArrowRight') nextLb();
    else if (e.key === 'ArrowLeft') prevLb();
  });
</script>
</Layout>
