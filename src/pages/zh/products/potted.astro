---
import Layout from '../../../layouts/Layout.astro';
import { getPottedSubCategories } from '../../../lib/products';

const subs = getPottedSubCategories();
const totalPhotos = subs.reduce((s, c) => s + c.count, 0);
---
<Layout title="盆栽 - 汇农天下" lang="zh" description="汇农天下盆栽 - 精品盆景与小微盆景合集，源头工厂直供。">
  <section class="hero hero-short">
    <div class="hero-content">
      <h1>盆栽</h1>
      <p class="hero-sub">{subs.length} 大分类 · {totalPhotos}+ 张图 · 精品盆景与小微盆景</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="back-row">
        <a href="/zh/products" class="back-link">← 返回产品目录</a>
      </div>

      <div class="cat-grid">
        {subs.map(sub => (
          <a href={`/zh/products/potted/${sub.slug}`} class="cat-card">
            <div class="cat-img" style={sub.cover ? `background-image: url('${sub.cover}');` : ''}></div>
            <div class="cat-body">
              <h3>{sub.zh}</h3>
              <p>{sub.zhDesc}</p>
              <span class="cat-cta">查看图集 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <h2>需要批量采购盆栽？</h2>
      <p>告诉我们数量、规格和目的地，12 小时内回复</p>
      <a href="/zh/contact?category=potted" class="btn-white">📩 立即询盘</a>
    </div>
  </section>
</Layout>

<style>
.hero-short { height: 280px; }
.hero {
  position: relative;
  height: 480px;
  overflow: hidden;
  background: linear-gradient(135deg, #3A5F3A 0%, #2A4A2A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-content {
  position: relative; z-index: 2; text-align: center;
  color: var(--white); max-width: 800px; padding: 0 24px;
}
.hero h1 { font-size: 40px; line-height: 1.2; margin-bottom: 12px; }
.hero-sub { font-size: 16px; opacity: 0.9; }
@media (max-width: 900px) {
  .hero-short { height: 200px; }
  .hero h1 { font-size: 28px; }
}

.section { padding: 56px 0; }
.container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

.back-row { margin-bottom: 24px; }
.back-link {
  color: var(--green);
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
}
.back-link:hover { text-decoration: underline; }

.cat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; }
.cat-card {
  background: var(--white);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: box-shadow .3s, transform .3s;
  display: block; color: inherit;
}
.cat-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }
.cat-img {
  width: 100%; height: 360px;
  background-color: #c9d4c5;
  background-size: cover; background-position: center;
  transition: transform .4s;
}
.cat-card:hover .cat-img { transform: scale(1.04); }
.cat-body { padding: 28px; }
.cat-body h3 { font-size: 24px; margin-bottom: 8px; color: var(--green); }
.cat-body p { font-size: 14px; color: var(--text-light); margin-bottom: 16px; line-height: 1.6; }
.cat-cta {
  display: inline-block;
  font-size: 14px;
  font-weight: 600;
  color: var(--green);
}

@media (max-width: 900px) {
  .cat-grid { grid-template-columns: 1fr; gap: 20px; }
  .cat-img { height: 240px; }
}

.cta-strip { background: var(--wood); padding: 56px 0; text-align: center; color: var(--white); }
.cta-strip h2 { font-size: 28px; margin-bottom: 12px; }
.cta-strip p { font-size: 15px; opacity: 0.9; margin-bottom: 28px; }
.btn-white {
  display: inline-block; background: var(--white);
  color: var(--wood) !important; padding: 14px 36px;
  border-radius: 4px; font-weight: 700; font-size: 16px;
  transition: transform .2s; cursor: pointer;
}
.btn-white:hover { transform: scale(1.03); }
</style>
