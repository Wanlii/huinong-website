---
import Layout from '../../../layouts/Layout.astro';
import { getAllProducts } from '../../../lib/products';

export function getStaticPaths() {
  return getAllProducts().map(p => ({ params: { slug: p.id } }));
}

const { slug } = Astro.params;
const product = getAllProducts().find(p => p.id === slug)!;
const hasImages = product.gallery.length > 0;
const isComplete = hasImages;

const categoryName = product.category === 'ornamental' ? 'Ornamental Plants' : 'Potted Plants (Bonsai)';
---
<Layout
  title={isComplete ? `${product.enName} - Product Details - Huinong` : `${product.enName} - Huinong`}
  lang="en"
  description={isComplete
    ? `${product.enName} (${product.latin}) - Premium quality from Huinong. FOB price on inquiry.`
    : `${product.enName} (${product.latin}) - Huinong premium product.`}
>
  <div class="breadcrumb">
    <div class="container">
      <a href="/en/">Home</a> › <a href="/en/products">Catalog</a> › <span>{product.enName}</span>
    </div>
  </div>

  {isComplete ? (
    <>
      <section class="section" style="padding-top: 32px;">
        <div class="container">
          <div class="pd-grid">
            <!-- Left: gallery -->
            <div class="pd-gallery">
              <div class="pd-main" id="pd-main" data-gallery={JSON.stringify(product.gallery)}>
                <img src={product.mainImage} alt={product.enName} />
              </div>
              {product.gallery.length > 1 && (
                <div class="pd-thumbs">
                  {product.gallery.map((img, i) => (
                    <div
                      class={`pd-thumb ${i === 0 ? 'active' : ''}`}
                      data-index={i}
                      data-image={img}
                    >
                      <img src={img} alt={`${product.enName} ${i+1}`} loading="lazy" />
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- Right: info (sticky) -->
            <div class="pd-info">
              <h1>{product.enName}</h1>
              <p class="latin">{product.latin} · {product.zhName}</p>

              <div class="short-desc">{product.shortDesc}</div>

              <div class="pd-meta">
                <div class="meta-item">
                  <div class="k">📷 Photos</div>
                  <div class="v">{product.gallery.length}</div>
                </div>
                <div class="meta-item">
                  <div class="k">🌿 Category</div>
                  <div class="v">{categoryName}</div>
                </div>
              </div>

              <div class="pd-actions">
                <a href={`/en/contact?product=${encodeURIComponent(product.enName)}`} class="btn-green" style="flex: 1; text-align: center;">📩 Inquire Now</a>
                <a href="#" class="btn-outline" title="WhatsApp">💬</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Product intro: full width -->
      <section class="section" style="padding-top: 0;">
        <div class="container">
          <div class="pd-content">
            <h3 class="pd-h3">Product Introduction</h3>
            <div class="long-desc">{product.longDesc}</div>
          </div>
        </div>
      </section>

      <section class="cta-strip">
        <div class="container">
          <h2>Want to source {product.enName}?</h2>
          <p>Tell us your specs, quantity & destination port</p>
          <a href={`/en/contact?product=${encodeURIComponent(product.enName)}`} class="btn-white">📩 Request a Quote</a>
        </div>
      </section>

      <!-- Lightbox -->
      <div class="lightbox" id="lightbox" aria-hidden="true">
        <button class="lightbox-close" aria-label="Close">×</button>
        <button class="lightbox-prev" aria-label="Previous">‹</button>
        <button class="lightbox-next" aria-label="Next">›</button>
        <div class="lightbox-content" id="lb-content"></div>
        <div class="lightbox-counter" id="lb-counter"></div>
      </div>
    </>
  ) : (
    <section class="section">
      <div class="container">
        <div class="placeholder-product">
          <div class="placeholder-emoji">{product.emoji}</div>
          <h1>{product.enName}</h1>
          <p class="latin">{product.latin} · {product.zhName}</p>
          <span class="placeholder-cat">Category: {categoryName}</span>
          <div class="short-desc" style="margin: 20px 0;">{product.shortDesc}</div>
          <div class="placeholder-msg">
            <p>{product.longDesc}</p>
            <p style="margin-top: 24px;">Product images and detailed specifications coming soon.</p>
            <p style="margin-top: 24px;">For inquiries, please <a href="/en/contact" class="btn-green">Contact Us</a> or browse <a href="/en/products">our catalog</a>.</p>
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
.breadcrumb { padding: 16px 0; font-size: 13px; color: var(--text-light); background: var(--cream-dark); }
.breadcrumb a { color: var(--text-light); }
.breadcrumb a:hover { color: var(--green); }
.breadcrumb span { color: var(--text); }

/* === Main layout: left 60% gallery / right 40% info (sticky) === */
.pd-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 36px;
  align-items: start;
}
.pd-gallery { display: flex; flex-direction: column; gap: 12px; }
.pd-main {
  width: 100%;
  aspect-ratio: 4 / 3;
  background: var(--cream-dark);
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  cursor: zoom-in;
  overflow: hidden;
  user-select: none;
}
.pd-main img { width: 100%; height: 100%; object-fit: cover; }

.pd-thumbs {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
  gap: 8px;
}
.pd-thumb {
  aspect-ratio: 1;
  background: var(--cream-dark);
  border-radius: 6px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  transition: border-color .2s, transform .15s;
  border: 2px solid transparent;
}
.pd-thumb img { width: 100%; height: 100%; object-fit: cover; }
.pd-thumb:hover { transform: translateY(-2px); }
.pd-thumb.active { border-color: var(--green); }

/* === Right info (sticky) === */
.pd-info {
  position: sticky;
  top: 100px;
  display: flex; flex-direction: column; gap: 14px;
}
.pd-info h1 { font-size: 28px; margin-bottom: 0; }
.pd-info .latin { font-size: 16px; color: var(--text-light); font-style: italic; margin: 0; }
.short-desc {
  font-size: 14px; color: var(--text); line-height: 1.7;
  padding: 14px 16px; background: var(--cream-dark);
  border-radius: 8px;
}
.pd-meta {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.meta-item {
  padding: 10px 14px;
  background: var(--cream);
  border-radius: 8px;
}
.meta-item .k { font-size: 11px; color: var(--text-light); }
.meta-item .v { font-size: 14px; font-weight: 600; margin-top: 4px; }
.pd-actions { display: flex; gap: 10px; margin-top: 6px; }
.pd-actions .btn-outline { padding: 12px 18px; min-width: 50px; text-align: center; font-size: 18px; }

/* === Product intro === */
.pd-content { max-width: 920px; margin: 0 auto; }
.pd-h3 { font-size: 18px; margin: 0 0 12px; color: var(--green); }
.long-desc { font-size: 15px; color: var(--text-light); line-height: 1.85; }

/* === Lightbox === */
.lightbox {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.92);
  z-index: 9999;
  align-items: center; justify-content: center;
  padding: 40px;
}
.lightbox.open { display: flex; }
.lightbox-content {
  max-width: 90%; max-height: 85vh;
  display: flex; align-items: center; justify-content: center;
  user-select: none;
}
.lightbox-content img { max-width: 100%; max-height: 85vh; object-fit: contain; }
.lightbox-close, .lightbox-prev, .lightbox-next {
  position: absolute;
  background: rgba(255, 255, 255, 0.1);
  color: white; border: none;
  font-size: 32px; line-height: 1;
  cursor: pointer;
  width: 56px; height: 56px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s;
}
.lightbox-close:hover, .lightbox-prev:hover, .lightbox-next:hover {
  background: rgba(255, 255, 255, 0.25);
}
.lightbox-close { top: 20px; right: 20px; }
.lightbox-prev { left: 20px; top: 50%; transform: translateY(-50%); }
.lightbox-next { right: 20px; top: 50%; transform: translateY(-50%); }
.lightbox-counter {
  position: absolute; bottom: 20px; left: 50%;
  transform: translateX(-50%);
  color: white; font-size: 14px; opacity: 0.7;
}

/* === Placeholder === */
.placeholder-product { text-align: center; max-width: 600px; margin: 0 auto; padding: 40px 0; }
.placeholder-emoji {
  font-size: 100px; margin: 0 auto 20px;
  width: 200px; height: 200px;
  background: linear-gradient(135deg, #c9d4c5 0%, #a3b89e 100%);
  border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
}
.placeholder-product h1 { font-size: 36px; margin-bottom: 8px; color: var(--green); }
.placeholder-cat {
  display: inline-block; background: var(--green);
  color: var(--white); padding: 4px 12px;
  border-radius: 12px; font-size: 13px;
  margin: 12px 0 24px;
}
.placeholder-msg { font-size: 15px; color: var(--text-light); line-height: 1.8; }
.placeholder-msg p { margin-bottom: 8px; }

/* === Responsive === */
@media (max-width: 900px) {
  .pd-grid { grid-template-columns: 1fr; gap: 24px; }
  .pd-info { position: static; }
  .pd-thumbs { grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); }
  .lightbox-close, .lightbox-prev, .lightbox-next { width: 44px; height: 44px; font-size: 24px; }
}
</style>

{isComplete && (
  <script>
    (() => {
      const thumbs = Array.from(document.querySelectorAll('.pd-thumb'));
      const main = document.getElementById('pd-main');
      const lightbox = document.getElementById('lightbox');
      const lbContent = document.getElementById('lb-content');
      const lbCounter = document.getElementById('lb-counter');
      if (!main || !lightbox || !lbContent) return;

      const allImages = JSON.parse(main.getAttribute('data-gallery') || '[]');
      const thumbItems = thumbs.map(t => ({ img: t.getAttribute('data-image'), el: t }));
      let currentIndex = 0;

      function renderIn(container, img) {
        if (img) container.innerHTML = '<img src="' + img + '" alt="" />';
      }

      function openLightbox(idx) {
        if (typeof idx === 'number') currentIndex = idx;
        renderIn(lbContent, allImages[currentIndex]);
        if (lbCounter) lbCounter.textContent = (currentIndex + 1) + ' / ' + allImages.length;
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
      }

      function navigate(dir) {
        currentIndex = (currentIndex + dir + allImages.length) % allImages.length;
        renderIn(lbContent, allImages[currentIndex]);
        if (lbCounter) lbCounter.textContent = (currentIndex + 1) + ' / ' + allImages.length;
        const thumbIdx = thumbItems.findIndex(t => t.img === allImages[currentIndex]);
        thumbs.forEach(t => t.classList.remove('active'));
        if (thumbIdx >= 0) thumbItems[thumbIdx].el.classList.add('active');
        renderIn(main, allImages[currentIndex]);
      }

      thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => {
          thumbs.forEach(t => t.classList.remove('active'));
          thumb.classList.add('active');
          currentIndex = i;
          renderIn(main, allImages[currentIndex]);
        });
      });

      main.addEventListener('click', () => openLightbox(currentIndex));

      const lbClose = lightbox.querySelector('.lightbox-close');
      const lbPrev = lightbox.querySelector('.lightbox-prev');
      const lbNext = lightbox.querySelector('.lightbox-next');
      if (lbClose) lbClose.addEventListener('click', closeLightbox);
      if (lbPrev) lbPrev.addEventListener('click', () => navigate(-1));
      if (lbNext) lbNext.addEventListener('click', () => navigate(1));
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') navigate(-1);
        if (e.key === 'ArrowRight') navigate(1);
      });
    })();
  </script>
)}
