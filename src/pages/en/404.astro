---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="404 - Page Not Found" lang="en" description="The page you visited does not exist.">
  <section class="section">
    <div class="container" style="text-align: center; padding: 80px 24px;">
      <h1 style="font-size: 96px; color: var(--green); margin-bottom: 16px; line-height: 1;">404</h1>
      <h2 style="font-size: 24px; margin-bottom: 16px;">Page Not Found</h2>
      <p style="font-size: 16px; color: var(--text-light); margin: 16px auto 32px; max-width: 480px;">The page you visited does not exist or has been moved.</p>
      <a href="/en/" class="btn-green">Back to Home</a>
    </div>
  </section>
</Layout>
