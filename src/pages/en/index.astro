---
import Layout from '../../layouts/Layout.astro';
import { getFeaturedProducts, getAllProducts, getActualSpeciesCounts } from '../../lib/products';
import fs from 'fs';
import path from 'path';

const featured = getFeaturedProducts();
const { ornamental: ornamentalCount, potted: pottedCount, total: totalProducts } = getActualSpeciesCounts();

const trustItems = [
  { num: '20+', label: 'Years of Experience' },
  { num: '8.6+', label: 'km² of Farmland' },
  { num: totalProducts + '+', label: 'Varieties Online' },
  { num: '100%', label: 'Compliant Export' },
];

const heroJpg = '/assets/images/hero/main.jpg';
const hasHero = fs.existsSync(path.join(process.cwd(), 'public/assets/images/hero/main.jpg'));

const categories = [
  { name: 'Ornamental Plants', desc: `Trees · Shrubs · ${ornamentalCount}+ varieties · bulk procurement`, image: '/assets/images/category/ornamental.jpg', href: '/en/products?cat=ornamental' },
  { name: 'Potted Plants (Bonsai)', desc: `Conifers · Hardwoods · Flowering · ${pottedCount}+ varieties · wholesale`, image: '/assets/images/category/potted.jpg', href: '/en/products?cat=potted' },
];
---
<Layout title="Huinong - Bonsai & Ornamental Plants Exporter" lang="en">
  <!-- 1. Hero -->
  <section class="hero" style={hasHero ? 'background: #2A4A2A;' : ''}>
    {hasHero && <img class="hero-bg" src={heroJpg} alt="" loading="eager" />}
    <div class="hero-content">
      <h1>From Source to the World</h1>
      <p class="hero-sub">Premium bonsai and ornamental plants · EU certified · 20 years of growing experience · source factory</p>
      <a href="/en/contact" class="btn-green hero-cta">Request a Quote →</a>
    </div>
  </section>

  <!-- 2. Trust bar -->
  <section class="trust-bar">
    <div class="container trust-inner">
      {trustItems.map(item => (
        <div class="trust-item">
          <div class="trust-num">{item.num}</div>
          <div class="trust-label">{item.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. 2 大类产品卡片 -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Product Categories</h2>
        <p>Two main categories for different procurement needs</p>
      </div>
      <div class="cat-grid">
        {categories.map(cat => (
          <a href={cat.href} class="cat-card">
            <div class="cat-img" style={`background-image: url('${cat.image}');`}></div>
            <div class="cat-body">
              <h3>{cat.name}</h3>
              <p>{cat.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Featured Products (4-col grid, same as catalog page) -->
  <section class="section products-bg">
    <div class="container">
      <div class="section-header">
        <h2>Featured Products</h2>
        <p>Main varieties, click for details</p>
      </div>
      <div class="product-grid">
        {featured.slice(0, 8).map(item => (
          <a href={`/en/products/${item.id}`} class="product-card">
            <div class="product-img">
              {item.mainImage ? <img src={item.mainImage} alt={item.enName} loading="lazy" /> : item.emoji}
            </div>
            <div class="product-info">
              <div class="product-name">{item.enName}</div>
              <div class="product-latin">{item.latin}</div>
              <div class="product-specs"><span>H {item.height}</span></div>
            </div>
          </a>
        ))}
      </div>
      <div style="text-align: center; margin-top: 32px;">
        <a href="/en/products" style="display: inline-block; padding: 12px 28px; background: var(--green); color: var(--white); border-radius: 4px; font-weight: 600;">View All Products →</a>
      </div>
    </div>
  </section>

  <!-- 5. CTA strip -->
  <section class="cta-strip">
    <div class="container">
      <h2>Looking to source plants?</h2>
      <p>Tell us your requirements, we'll reply within 12 hours</p>
      <a href="/en/contact" class="btn-white">📩 Request a Quote</a>
    </div>
  </section>
</Layout>

<style>
.hero {
  position: relative;
  height: 480px;
  overflow: hidden;
  background: linear-gradient(135deg, #3A5F3A 0%, #2A4A2A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: 0;
  opacity: 0.55;
}
.hero-content {
  position: relative; z-index: 2; text-align: center;
  color: var(--white); max-width: 800px; padding: 0 24px;
}
.hero h1 { font-size: 44px; line-height: 1.2; margin-bottom: 16px; }
.hero-sub { font-size: 17px; opacity: 0.9; margin-bottom: 32px; line-height: 1.6; }
.hero-cta { font-size: 16px; padding: 14px 32px; }

@media (max-width: 900px) {
  .hero { height: 360px; }
  .hero h1 { font-size: 30px; }
  .hero-sub { font-size: 15px; }
}

.trust-bar { background: var(--green-dark); padding: 28px 0; }
.trust-inner {
  display: flex; justify-content: space-around; align-items: center;
  flex-wrap: wrap; gap: 32px;
}
.trust-item { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,0.9); }
.trust-num {
  font-family: 'Playfair Display', 'Georgia', serif;
  font-size: 28px; font-weight: 700; color: var(--white); line-height: 1;
}
.trust-label { font-size: 13px; opacity: 0.8; line-height: 1.3; }

@media (max-width: 900px) {
  .trust-num { font-size: 22px; }
}

.section { padding: 72px 0; }
.section-header { text-align: center; margin-bottom: 48px; }
.section-header h2 { font-size: 32px; color: var(--text); margin-bottom: 12px; }
.section-header p { font-size: 15px; color: var(--text-light); max-width: 600px; margin: 0 auto; }
.products-bg { background: var(--cream-dark); }

@media (max-width: 900px) {
  .section { padding: 48px 0; }
  .section-header h2 { font-size: 24px; }
}

.cat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px; }
.cat-card {
  background: var(--white);
  border-radius: 8px;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: box-shadow .3s;
}
.cat-card:hover { box-shadow: var(--shadow-lg); }
.cat-img {
  width: 100%;
  height: 240px;
  background-color: #c9d4c5;
  background-size: cover;
  background-position: center;
  position: relative;
  transition: transform .4s;
}
.cat-card:hover .cat-img { transform: scale(1.04); }
.cat-body { padding: 24px; }
.cat-body h3 { font-size: 20px; margin-bottom: 6px; color: var(--green); }
.cat-body p { font-size: 14px; color: var(--text-light); }

@media (max-width: 900px) {
  .cat-grid { grid-template-columns: 1fr; }
}

.featured-wrapper { position: relative; margin: 0 -8px; }
.featured-track {
  display: flex; gap: 20px; overflow-x: auto;
  scroll-behavior: smooth; padding: 8px;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.featured-track::-webkit-scrollbar { display: none; }
.product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.product-card {
  background: var(--white); border-radius: 8px; overflow: hidden;
  box-shadow: var(--shadow);
  transition: transform .2s, box-shadow .2s;
}
.product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
.product-img {
  width: 100%; height: 180px;
  background: linear-gradient(135deg, #d4c4a8 0%, #b8a888 100%);
  display: flex; align-items: center; justify-content: center;
  font-size: 50px; overflow: hidden;
}
.product-img img { width: 100%; height: 100%; object-fit: cover; }
.product-info { padding: 18px; }
.product-name { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.product-latin {
  font-size: 12px; color: var(--text-light);
  font-style: italic; margin-bottom: 10px;
}
.product-specs {
  display: flex; gap: 12px; font-size: 12px; color: var(--text-light);
  border-top: 1px solid var(--cream-dark); padding-top: 10px;
}
.scroll-btn {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--white); border: 1px solid var(--cream-dark);
  box-shadow: var(--shadow);
  cursor: pointer; font-size: 24px; line-height: 1;
  color: var(--green); z-index: 5;
  transition: all .2s;
}
.scroll-btn:hover { background: var(--green); color: var(--white); border-color: var(--green); }
.scroll-prev { left: -8px; }
.scroll-next { right: -8px; }

.cta-strip { background: var(--wood); padding: 56px 0; text-align: center; color: var(--white); }
.cta-strip h2 { font-size: 28px; margin-bottom: 12px; }
.cta-strip p { font-size: 15px; opacity: 0.9; margin-bottom: 28px; }
.btn-white {
  display: inline-block; background: var(--white);
  color: var(--wood) !important; padding: 14px 36px;
  border-radius: 4px; font-weight: 700; font-size: 16px;
  transition: transform .2s; cursor: pointer;
}
.btn-white:hover { transform: scale(1.03); }

@media (max-width: 900px) {
  .product-grid { grid-template-columns: repeat(2, 1fr); }
  .scroll-btn { display: none; }
  .cta-strip h2 { font-size: 22px; }
}
@media (max-width: 600px) {
  .product-grid { grid-template-columns: 1fr; }
}
</style>

<script>
  // Featured products now use grid layout, no scroll needed
</script>
