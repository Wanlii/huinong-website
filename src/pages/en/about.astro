---
import Layout from '../../layouts/Layout.astro';

const stats = [
  { num: '860+', label: 'Hectares of Base' },
  { num: '600K+', label: 'Plants in Stock' },
  { num: '40+', label: 'Export Countries' },
  { num: '20+', label: 'Years in Industry' },
];

const team = [
  { name: 'Founder / GM', role: '20+ years experience', desc: 'Strategy and base management', emoji: '👨‍🌾' },
  { name: 'Export Director', role: '10+ years in trade', desc: 'European and Central Asian markets', emoji: '👩‍💼' },
  { name: 'QA Manager', role: 'Phytosanitary expert', desc: 'Compliance and quality control', emoji: '👨‍🔬' },
];

const milestones = [
  { year: '2003', text: 'Founded in Xinyi, Jiangsu, leveraging the local flower & tree production region' },
  { year: '2008', text: 'Expanded base, started large-scale shaped plant production' },
  { year: '2012', text: 'First export, entered Southeast Asian markets' },
  { year: '2016', text: 'Obtained export registration, entered EU market' },
  { year: '2020', text: 'Base expanded to 860 hectares, annual exports exceeded 10M' },
  { year: '2026', text: 'Serving 40+ countries, ~30,000 plants exported annually' },
];

const commitments = [
  { icon: '🌱', title: 'Source Control', desc: 'Every plant from our own 860 ha base' },
  { icon: '📜', title: 'Compliance First', desc: 'EU 2016/2031 & 2019/2072 fully compliant' },
  { icon: '🤝', title: 'Long-term Win', desc: 'Not a one-time deal, a lasting partnership' },
  { icon: '📢', title: 'Transparency', desc: 'Specs, pricing, and timelines disclosed honestly' },
];
---
<Layout title="About Us - Huinong" lang="en" description="Huinong - Founded 2003, Xinyi Jiangsu. 860 hectares of self-owned base. Premium ornamental plants and bonsai exporter.">
  <section class="hero hero-short">
    <div class="hero-content">
      <h1>About Us</h1>
      <p class="hero-sub">From Seedlings to Bonsai, From China to the World</p>
    </div>
  </section>

  <!-- Company Introduction -->
  <section class="section">
    <div class="container">
      <div class="intro-grid">
        <div class="intro-text">
          <div class="kicker">About Us</div>
          <h2>From Source to the World</h2>
          <p class="lead">Huinong was founded in <strong>2003</strong>, headquartered in Xinyi City, Jiangsu Province — at the heart of China's largest flower and tree production region.</p>
          <p>With its favorable climate, fertile soil, and flat terrain, the region hosts over 10,000 horticultural enterprises and spans 400,000+ hectares of cultivation area — making it China's largest and most complete horticultural industry cluster.</p>
          <p>Leveraging these regional resources, Huinong has grown over 20+ years into one of China's leading ornamental horticulture production and service companies:</p>
          <ul class="intro-list">
            <li><strong>860+ hectares</strong> of self-owned base</li>
            <li><strong>600,000+ plants</strong> in stock</li>
            <li><strong>~30,000 plants</strong> exported annually</li>
            <li>Specialties: Chinese-style shaped plants / international-standard ornamentals / small potted plants</li>
          </ul>
          <p class="quote">"We don't just sell plants — we aim to be a trusted long-term partner for horticultural buyers worldwide."</p>
        </div>
        <div class="intro-imgs">
          <img src="/assets/images/company/nursery/main.jpg" alt="Huinong nursery" />
          <img src="/assets/images/company/factory/main.jpg" alt="Huinong factory" />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section products-bg">
    <div class="container">
      <div class="section-header"><h2>Key Figures</h2><p>The numbers behind our strength</p></div>
      <div class="stats-grid">
        {stats.map(s => (
          <div class="stat-item">
            <div class="stat-num">{s.num}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section">
    <div class="container">
      <div class="section-header"><h2>Core Team</h2><p>Professionals doing professional work</p></div>
      <div class="team-grid">
        {team.map(t => (
          <div class="team-card">
            <div class="team-avatar">{t.emoji}</div>
            <h4>{t.name}</h4>
            <div class="role">{t.role}</div>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Milestones -->
  <section class="section products-bg">
    <div class="container">
      <div class="section-header"><h2>Milestones</h2><p>From 2003 to 2026</p></div>
      <div class="timeline">
        {milestones.map(m => (
          <div class="timeline-item">
            <h4>{m.year}</h4>
            <p>{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Commitments -->
  <section class="section">
    <div class="container">
      <div class="section-header"><h2>Our Commitments</h2><p>Making every deal worry-free</p></div>
      <div class="commit-grid">
        {commitments.map(c => (
          <div class="commit-card">
            <div class="commit-icon">{c.icon}</div>
            <h4>{c.title}</h4>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <h2>Want to know more?</h2>
      <p>Get in touch, or browse our product catalog first</p>
      <a href="/en/contact" class="btn-white">📩 Contact Us</a>
    </div>
  </section>
</Layout>

<style>
.intro-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 56px; align-items: center; }
.intro-text .kicker {
  display: inline-block; font-size: 12px; letter-spacing: 2px;
  text-transform: uppercase; color: var(--green); font-weight: 600;
  margin-bottom: 12px;
}
.intro-text h2 { font-size: 36px; color: var(--green-dark); margin-bottom: 20px; }
.intro-text .lead { font-size: 17px; color: var(--text); margin-bottom: 16px; line-height: 1.7; }
.intro-text p { font-size: 15px; color: var(--text-light); line-height: 1.8; margin-bottom: 14px; }
.intro-list { list-style: none; margin: 20px 0; padding: 0; }
.intro-list li {
  padding: 8px 0; border-bottom: 1px solid var(--cream-dark);
  font-size: 14px; color: var(--text);
}
.intro-list li:last-child { border-bottom: none; }
.intro-text .quote {
  font-style: italic; color: var(--green); font-size: 15px;
  padding: 16px 20px; background: var(--cream); border-left: 3px solid var(--green);
  border-radius: 4px; margin-top: 20px;
}
.intro-imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.intro-imgs img {
  width: 100%; height: 220px; object-fit: cover; border-radius: 8px;
  box-shadow: var(--shadow);
}

.stats-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
  background: var(--green-dark); padding: 32px; border-radius: 8px; color: var(--white);
}
.stat-item { text-align: center; }
.stat-num { font-family: 'Playfair Display', 'Georgia', serif; font-size: 36px; font-weight: 700; line-height: 1; margin-bottom: 8px; }
.stat-label { font-size: 14px; opacity: 0.85; }

.team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.team-card {
  background: var(--white); border-radius: 8px; padding: 24px;
  text-align: center; box-shadow: var(--shadow);
}
.team-avatar {
  width: 80px; height: 80px; border-radius: 50%;
  background: var(--cream-dark); margin: 0 auto 12px;
  display: flex; align-items: center; justify-content: center; font-size: 40px;
}
.team-card h4 { font-size: 16px; margin-bottom: 4px; }
.team-card .role { font-size: 13px; color: var(--green); margin-bottom: 8px; font-weight: 600; }
.team-card p { font-size: 13px; color: var(--text-light); line-height: 1.6; }

.timeline { max-width: 700px; margin: 0 auto; position: relative; padding-left: 32px; }
.timeline::before { content: ""; position: absolute; left: 8px; top: 0; bottom: 0; width: 2px; background: var(--green-light); }
.timeline-item { position: relative; margin-bottom: 28px; }
.timeline-item::before {
  content: ""; position: absolute; left: -28px; top: 4px;
  width: 14px; height: 14px; border-radius: 50%;
  background: var(--green); border: 3px solid var(--cream);
}
.timeline-item h4 { font-size: 16px; margin-bottom: 4px; color: var(--green); }
.timeline-item p { font-size: 14px; color: var(--text-light); }

.commit-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.commit-card {
  background: var(--white); border: 1px solid var(--cream-dark);
  border-radius: 8px; padding: 28px 20px; text-align: center;
  transition: border-color .2s;
}
.commit-card:hover { border-color: var(--green-light); }
.commit-icon { font-size: 36px; margin-bottom: 14px; }
.commit-card h4 { font-size: 15px; margin-bottom: 8px; }
.commit-card p { font-size: 13px; color: var(--text-light); }

.cta-strip { background: var(--wood); padding: 56px 0; text-align: center; color: var(--white); }
.cta-strip h2 { font-size: 28px; margin-bottom: 12px; }
.cta-strip p { font-size: 15px; opacity: 0.9; margin-bottom: 28px; }
.btn-white {
  display: inline-block; background: var(--white);
  color: var(--wood) !important; padding: 14px 36px;
  border-radius: 4px; font-weight: 700; font-size: 16px;
  transition: transform .2s; cursor: pointer;
}
.btn-white:hover { transform: scale(1.03); }

.section { padding: 72px 0; }
.section-header { text-align: center; margin-bottom: 48px; }
.section-header h2 { font-size: 32px; color: var(--text); margin-bottom: 12px; }
.section-header p { font-size: 15px; color: var(--text-light); max-width: 600px; margin: 0 auto; }
.products-bg { background: var(--cream-dark); }

@media (max-width: 900px) {
  .intro-grid { grid-template-columns: 1fr; gap: 32px; }
  .intro-imgs { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .team-grid { grid-template-columns: 1fr; }
  .commit-grid { grid-template-columns: repeat(2, 1fr); }
  .section { padding: 48px 0; }
  .section-header h2 { font-size: 24px; }
}
</style>
