---
import Layout from '../layouts/Layout.astro';

const channels = [
  { icon: '📧', title: 'Email · Sales Manager Shirley', content: 'shirley.jiang@huinonghort.com' },
  { icon: '📧', title: 'Email · General Manager Ma ShuangYang', content: 'ma@huinonghort.com' },
  { icon: '📞', title: 'Landline', content: '+86 0516 8857 6789' },
  { icon: '📞', title: 'Shirley Mobile', content: '+86 1385 7408 273' },
];

const countries = [
  'Germany', 'France', 'Netherlands', 'Spain', 'Italy', 'Poland',
  'Turkey', 'Saudi Arabia', 'UAE', 'Israel', 'Qatar', 'Kuwait',
  'Kazakhstan', 'Uzbekistan', 'Kyrgyzstan', 'Other'
];
---
<Layout title="Contact - Huinong" lang="en" description="Contact Huinong: email, phone. Reply within 12 hours.">
  <section class="hero hero-short">
    <div class="hero-content">
      <h1>Contact</h1>
      <p class="hero-sub">Reply within 12 hours · smooth communication</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div>
          <h2 style="font-size: 24px; margin-bottom: 12px;">Multi-channel Contact</h2>
          <p style="font-size: 14px; color: var(--text-light); margin-bottom: 20px;">Choose what works best for you. We reply within 12 hours.</p>

          {channels.map(c => (
            <div class="contact-card">
              <div class="icon">{c.icon}</div>
              <div>
                <h4>{c.title}</h4>
                <p>{c.content}</p>
              </div>
            </div>
          ))}

          <div class="time-note">
            <strong>Working hours:</strong> Mon - Sat 09:00-18:00 (GMT+8)<br>
            <strong>Europe time diff:</strong> Beijing 09:00 = Berlin 03:00. We recommend email, reply within 12 hours.
          </div>
        </div>

        <div class="form-wrap">
          <h2>📩 Inquiry Form</h2>
          <p>Tell us your needs, we'll reply within 12 hours</p>

          <form id="inquiry-form" action="#" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label>Company *</label>
                <input type="text" name="company" placeholder="Your company name" required>
              </div>
              <div class="form-group">
                <label>Country *</label>
                <select name="country" required>
                  <option value="">Please select</option>
                  {countries.map(c => <option value={c}>{c}</option>)}
                </select>
              </div>
              <div class="form-group">
                <label>Name *</label>
                <input type="text" name="name" placeholder="First Last" required>
              </div>
              <div class="form-group">
                <label>Email *</label>
                <input type="email" name="email" placeholder="you@company.com" required>
              </div>
              <div class="form-group">
                <label>Phone</label>
                <input type="tel" name="phone" placeholder="+xx xxx xxx xxxx">
              </div>
              <div class="form-group">
                <label>Category of interest</label>
                <select name="category">
                  <option value="">Please select</option>
                  <option value="potted">Potted Plants (Bonsai)</option>
                  <option value="ornamental">Ornamental Plants</option>
                  <option value="undecided">Undecided, need advice</option>
                </select>
              </div>
              <div class="form-group full">
                <label>Message *</label>
                <textarea name="message" placeholder="Describe your needs: products, specs, quantity, destination port, etc." required></textarea>
              </div>
              <div class="form-group full">
                <button type="submit" class="btn-green" style="width: 100%; padding: 14px;">📩 Submit Inquiry</button>
              </div>
            </div>
            <p style="font-size: 12px; color: var(--text-light); text-align: center; margin-top: 12px;">By submitting, you agree to our processing of the information you provide.</p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section products-bg">
    <div class="container">
      <div class="section-header"><h2>Our Location</h2><p>Visit our base by appointment</p></div>
      <div class="map-wrap">
        <div class="map-info">
          <div class="map-icon">📍</div>
          <div>
            <div class="map-title">Huinong Base — Xinyi City, Jiangsu Province, China</div>
            <div class="map-sub">Self-owned 860+ hectares · Source factory · Visits by appointment</div>
            <a class="map-link" href="https://www.google.com/maps/search/?api=1&query=Xinyi+City+Jiangsu+China" target="_blank" rel="noopener">Open in Google Maps →</a>
          </div>
        </div>
        <iframe
          class="map-frame"
          title="Huinong Base Location"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://maps.google.com/maps?q=Xinyi+City+Jiangsu+China&t=&z=11&ie=UTF8&iwloc=&output=embed">
        </iframe>
      </div>
    </div>
  </section>
</Layout>

<style>
.contact-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: start; }
.contact-card {
  background: var(--white); border: 1px solid var(--cream-dark);
  border-radius: 8px; padding: 18px; margin-bottom: 12px;
  display: flex; gap: 14px; align-items: flex-start;
}
.contact-card .icon { font-size: 24px; flex-shrink: 0; }
.contact-card h4 { font-size: 14px; margin-bottom: 4px; }
.contact-card p { font-size: 13px; color: var(--text-light); line-height: 1.6; }
.time-note {
  background: var(--cream-dark); padding: 12px 16px;
  border-radius: 6px; font-size: 13px; color: var(--text-light);
  margin: 16px 0;
}

.form-wrap { background: var(--white); padding: 28px; border-radius: 12px; box-shadow: var(--shadow); }
.form-wrap h2 { font-size: 22px; margin-bottom: 6px; }
.form-wrap > p { font-size: 14px; color: var(--text-light); margin-bottom: 22px; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 600px; }
.form-grid .full { grid-column: 1 / -1; }
.form-group label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
.form-group input, .form-group textarea, .form-group select {
  width: 100%; padding: 11px 14px; border: 1px solid #ddd;
  border-radius: 4px; font-size: 14px; font-family: inherit;
}
.form-group input:focus, .form-group textarea:focus, .form-group select:focus {
  outline: none; border-color: var(--green);
}
.form-group textarea { min-height: 110px; resize: vertical; }

.map-wrap {
  background: var(--white);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.map-info {
  display: flex;
  gap: 14px;
  align-items: flex-start;
  padding: 20px 24px;
  background: var(--cream);
  border-bottom: 1px solid var(--cream-dark);
}
.map-info .map-icon { font-size: 28px; line-height: 1; }
.map-title { font-size: 16px; font-weight: 600; color: var(--green); }
.map-sub { font-size: 13px; color: var(--text-light); margin-top: 4px; }
.map-link {
  display: inline-block;
  margin-top: 10px;
  font-size: 13px;
  color: var(--green);
  text-decoration: none;
  font-weight: 600;
  border-bottom: 1px solid transparent;
  transition: border-color .2s;
}
.map-link:hover { border-bottom-color: var(--green); }
.map-frame {
  display: block;
  width: 100%;
  height: 380px;
  border: 0;
}
.map-box {
  width: 100%; height: 320px;
  background: linear-gradient(135deg, #e8e2d4 0%, #d4cab8 100%);
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-light); font-size: 15px;
}

@media (max-width: 900px) {
  .contact-grid { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('inquiry-form');
    if (!form) return;

    form.querySelectorAll('input, select, textarea').forEach(el => {
      el.addEventListener('input', () => { el.style.borderColor = ''; });
      el.addEventListener('change', () => { el.style.borderColor = ''; });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const required = form.querySelectorAll('[required]');
      let valid = true;
      let firstInvalid: HTMLElement | null = null;

      required.forEach(field => {
        const el = field as HTMLElement;
        if (!el.value.trim()) {
          valid = false;
          el.style.borderColor = '#c0392b';
          if (!firstInvalid) firstInvalid = el;
        } else {
          el.style.borderColor = '';
        }
      });

      const email = form.querySelector('input[type="email"]') as HTMLInputElement | null;
      if (email && email.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
        valid = false;
        email.style.borderColor = '#c0392b';
        if (!firstInvalid) firstInvalid = email;
        alert('Please enter a valid email address');
      }

      if (!valid) {
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (!submitBtn) return;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = 'Submitting...';
      submitBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const data: Record<string, string> = {};
        formData.forEach((v, k) => { if (typeof v === 'string') data[k] = v; });
        data.lang = window.location.pathname.startsWith('/en') ? 'en' : 'zh';

        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        if (res.ok) {
          submitBtn.textContent = '✓ Submitted! We will contact you soon';
          form.reset();
          setTimeout(() => {
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
          }, 4000);
        } else {
          const err = await res.text();
          alert('Submission failed: ' + err);
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      } catch (err) {
        alert('Network error: ' + (err as Error).message);
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
</script>
