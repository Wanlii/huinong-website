---
import Layout from '../layouts/Layout.astro';

const certs = [
  { icon: '📜', title: 'Phytosanitary Certificate', desc: 'Issued by the General Administration of Customs of China, certifying that exported plant products meet the phytosanitary requirements of destination countries/regions. Original certificate accompanies every shipment, required for EU and other customs clearance.' },
  { icon: '🏭', title: 'Export Registration', desc: 'Registered with the General Administration of Customs as a qualified exporter. We provide the registration number for clients to verify in the official system.' },
  { icon: '🌡️', title: 'Fumigation / Quarantine Treatment Certificate', desc: 'Fumigation treatment upon client request, with official certificate. Common methods: methyl bromide, aluminum phosphide, temperature treatment.' },
  { icon: '✅', title: 'EU Compliance Certification', desc: 'Strict compliance with EU phytosanitary regulations: EU 2016/2031 (Plant Health Regulation) / EU 2019/2072 (Uniform Phytosanitary Measures) / EU 2020/1201 (Pest Emergency Measures). Clients can verify on EUR-Lex official system.' },
];

const regs = [
  { code: 'EU 2016/2031', desc: 'EU Plant Health Regulation' },
  { code: 'EU 2019/2072', desc: 'Uniform Phytosanitary Measures' },
  { code: 'EU 2020/1201', desc: 'Pest Emergency Measures' },
  { code: 'ISPM 12', desc: 'Phytosanitary Certificates Standard' },
  { code: 'CITES', desc: 'Convention on International Trade in Endangered Species' },
  { code: 'IPPC', desc: 'International Plant Protection Convention' },
];
---
<Layout title="Certifications - Huinong" lang="en" description="Huinong export certifications: Phytosanitary Certificate, Export Registration, Fumigation Certificate, EU 2016/2031 & 2019/2072 compliance.">
  <section class="hero hero-short">
    <div class="hero-content">
      <h1>Certifications</h1>
      <p class="hero-sub">Compliant exports · order with confidence</p>
    </div>
  </section>

  <section class="section" style="padding-bottom: 32px;">
    <div class="container">
      <p style="text-align: center; max-width: 720px; margin: 0 auto; font-size: 15px; line-height: 1.8; color: var(--text-light);">
        Huinong holds full export qualifications and strictly complies with international phytosanitary regulations. All exported products come with official Phytosanitary Certificates, meeting EU Plant Health Regulations (EU 2016/2031 & EU 2019/2072).
      </p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      {certs.map(c => (
        <div class="cert-row">
          <div class="cert-big">{c.icon}</div>
          <div>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
            <a href="#" class="btn-green" style="font-size: 13px; padding: 8px 14px;">📥 Download Sample (redacted)</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section products-bg">
    <div class="container">
      <div class="section-header"><h2>CITES Compliance Statement</h2><p>Our commitment for protected species</p></div>
      <div style="max-width: 720px; margin: 0 auto; padding: 28px; background: var(--cream); border-radius: 12px; text-align: center;">
        <div style="font-size: 42px; margin-bottom: 12px;">🦜</div>
        <p style="font-size: 15px; line-height: 1.8;">
          <strong>Huinong commits</strong>: All exports of CITES-protected species come with valid CITES export permits.<br>
          <span style="color: var(--text-light); font-size: 14px;">CITES (Convention on International Trade in Endangered Species) permits must be issued by both the exporting and importing countries.</span>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header"><h2>Regulations We Follow</h2><p>Verifiable on official systems</p></div>
      <div class="reg-grid">
        {regs.map(r => (
          <div class="reg-card">
            <h4>{r.code}</h4>
            <p>{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-strip">
    <div class="container">
      <h2>Need certification documents?</h2>
      <p>We'll provide the relevant files for your order</p>
      <a href="/contact" class="btn-white">📩 Contact Us</a>
    </div>
  </section>
</Layout>

<style>
.cert-row {
  display: grid; grid-template-columns: 1fr 2.5fr; gap: 40px; align-items: center;
  margin: 24px 0; padding: 28px; background: var(--white);
  border-radius: 12px; box-shadow: var(--shadow);
}
.cert-big { font-size: 70px; text-align: center; }
.cert-row h3 { font-size: 20px; margin-bottom: 10px; color: var(--green); }
.cert-row p { font-size: 14px; line-height: 1.7; color: var(--text-light); margin-bottom: 10px; }

.reg-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
.reg-card {
  background: var(--white); border: 1px solid var(--cream-dark);
  border-radius: 8px; padding: 22px;
}
.reg-card h4 { font-size: 15px; margin-bottom: 6px; color: var(--green); }
.reg-card p { font-size: 13px; color: var(--text-light); line-height: 1.6; }

@media (max-width: 900px) {
  .cert-row { grid-template-columns: 1fr; }
  .reg-grid { grid-template-columns: 1fr; }
}
</style>
